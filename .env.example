# Telegram Bot API token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# Comma-separated Telegram user IDs allowed to operate the bot (required for write commands)
# Get your ID via @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# Optional: default channel ID for /post when no channel is chosen
# DEFAULT_CHANNEL_ID=-1001234567890

# Optional: SQLite database path (default: ./data/bot.db)
# DB_PATH=./data/bot.db
